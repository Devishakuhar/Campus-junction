
<style>
  /* Full-width banner sections (shared) */
  #cg-banner-1,
  #cg-banner-2,
  #cg-banner-3,
  #cg-banner-4 {
    width: 100%;
  }

  #cg-denim-section .cg-full-cta-wrap {
    position: relative;
    width: 100%;
    line-height: 0;
    display: block;
    text-decoration: none;
  }

  #cg-denim-section .cg-full-cta-media,
  #cg-denim-section .cg-full-cta-placeholder {
    width: 100%;
  }

  #cg-denim-section .cg-full-cta-img {
    width: 100%;
    height: auto;
    display: block;
  }

  #cg-denim-section .cg-full-cta-placeholder {
    min-height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f3f3f3;
    color: #222;
    font-size: 16px;
    text-align: center;
    padding: 20px;
  }

  /* Image grid section */
  #cg-denim-section .cg-image-grid-section {
    width: 100%;
    padding: 30px 0;
    position: relative;
    overflow: hidden;
    background-image: url("//craftandglory.in/cdn/shop/files/LDP_bg_color.jpg?v=1776443017&width=2400");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  #cg-denim-section .cg-image-grid-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    text-align: center;
  }

  #cg-denim-section .cg-image-grid-header {
    font-family: serif;
    font-size: 52px;
    color: #8c2a12;
    text-transform: uppercase;
    font-weight: bold;
    margin-bottom: 60px;
    letter-spacing: 0.02em;
  }

  #cg-denim-section .cg-image-grid-wrapper {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    margin-bottom: 70px;
    justify-items: center;
  }

  #cg-denim-section .cg-image-grid-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    width: 100%;
    max-width: 330px;
  }

  #cg-denim-section .cg-image-grid-card-outer {
    transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
  }

  #cg-denim-section .cg-image-grid-card-link:hover .cg-image-grid-card-outer {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.15);
  }

  #cg-denim-section .cg-image-grid-item {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    position: relative;
    box-shadow: 0 4px 10px rgba(0,0,0,0.08);
  }

  #cg-denim-section .cg-image-grid-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #cg-denim-section .cg-image-grid-item-label {
    font-family: sans-serif;
    color: #1a1a1a;
    text-transform: uppercase;
    font-size: 16px;
    font-weight: 600;
    margin-top: 20px;
    line-height: 1.4;
    letter-spacing: 0.01em;
  }

  #cg-denim-section .cg-cta-wrapper {
    margin-top: 30px;
  }

  #cg-denim-section .cg-image-grid-cta-button {
    display: inline-block;
    padding: 16px 50px;
    background-color: #8c2a12;
    color: #ffffff;
    text-decoration: none;
    font-family: sans-serif;
    text-transform: uppercase;
    font-size: 24px;
    font-weight: 600;
    transition: background-color 0.2s ease-in-out;
    letter-spacing: 0.01em;
  }

  #cg-denim-section .cg-image-grid-cta-button:hover {
    background-color: #a83618;
  }

  @media (max-width: 900px) {
    #cg-denim-section .cg-image-grid-header {
      font-size: 36px;
      margin-bottom: 40px;
    }

    #cg-denim-section .cg-image-grid-cta-button {
      font-size: 20px;
      padding: 14px 40px;
    }

    #cg-denim-section .cg-image-grid-wrapper {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-left: 20px;
      gap: 15px;
      padding-bottom: 20px;
      margin-bottom: 40px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    #cg-denim-section .cg-image-grid-wrapper::-webkit-scrollbar {
      display: none;
    }

    #cg-denim-section .cg-image-grid-card-link {
      flex: 0 0 80%;
      max-width: none;
      scroll-snap-align: start;
    }
  }

  @media (max-width: 600px) {
    #cg-denim-section .cg-image-grid-card-link {
      flex: 0 0 85%;
    }
  }
</style>

