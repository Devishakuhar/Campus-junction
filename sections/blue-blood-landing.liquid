<section class="bb-landing">
  <div class="bb-container">

    <!-- HERO -->
    <div class="bb-hero">
      <div class="bb-launch-tag">NEW LAUNCH</div>

      <div class="bb-hero-grid">
        <div class="bb-content">
          <h1>{{ section.settings.hero_title }}</h1>
          <p>{{ section.settings.hero_description }}</p>
        </div>

        <div class="bb-image">
          {% if section.settings.hero_image %}
            {{
              section.settings.hero_image
              | image_url: width: 1000
              | image_tag
            }}
          {% endif %}
        </div>
      </div>
    </div>

    <!-- BUILT TO LAST -->
    <div class="bb-built">
      <h2>BUILT WITH THE INTENT TO LAST</h2>

      <div class="bb-fit-grid">
        {% for block in section.blocks %}
          {% if block.type == 'fit_image' %}
            <div class="bb-fit-item">
              {{
                block.settings.image
                | image_url: width: 500
                | image_tag
              }}
              <span>{{ block.settings.label }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- PRODUCT 1 -->
    <div class="bb-product">
      <h2>{{ section.settings.product1_title }}</h2>

      <div class="bb-product-grid">
        <div class="bb-product-image">
          {{
            section.settings.product1_image
            | image_url: width: 1200
            | image_tag
          }}
        </div>

        <div class="bb-product-content">
          <p>{{ section.settings.product1_text }}</p>

          <a href="{{ section.settings.product1_link }}"
             class="bb-btn">
            SHOP NOW
          </a>

          {{
            section.settings.product1_fabric
            | image_url: width: 600
            | image_tag
          }}
        </div>
      </div>
    </div>

    <!-- HERITAGE -->
    <div class="bb-heritage">

      <div class="bb-heritage-text">
        <h2>WHAT MAKES SELVEDGE DIFFERENT?</h2>
        <p>{{ section.settings.heritage_text }}</p>
      </div>

      <div class="bb-heritage-image">
        {{
          section.settings.heritage_image
          | image_url: width: 1000
          | image_tag
        }}
      </div>

    </div>

    <!-- PRODUCT 2 -->
    <div class="bb-product">

      <h2>{{ section.settings.product2_title }}</h2>

      <div class="bb-product-grid">

        <div class="bb-product-image">
          {{
            section.settings.product2_image
            | image_url: width: 1200
            | image_tag
          }}
        </div>

        <div class="bb-product-content">
          <p>{{ section.settings.product2_text }}</p>

          <a href="{{ section.settings.product2_link }}"
             class="bb-btn">
            SHOP NOW
          </a>
        </div>

      </div>
    </div>

    <!-- PRODUCT 3 -->
    <div class="bb-product">

      <h2>{{ section.settings.product3_title }}</h2>

      <div class="bb-product-grid">

        <div class="bb-product-image">
          {{
            section.settings.product3_image
            | image_url: width: 1200
            | image_tag
          }}
        </div>

        <div class="bb-product-content">
          <p>{{ section.settings.product3_text }}</p>

          <a href="{{ section.settings.product3_link }}"
             class="bb-btn">
            SHOP NOW
          </a>
        </div>

      </div>
    </div>

    <!-- BORN FROM WORK -->
    <div class="bb-story">

      <h2>BORN FROM WORK</h2>

      <div class="bb-story-grid">

        <div class="bb-story-images">
          {{
            section.settings.story_image_1
            | image_url: width: 600
            | image_tag
          }}

          {{
            section.settings.story_image_2
            | image_url: width: 600
            | image_tag
          }}
        </div>

        <div class="bb-story-content">
          <p>{{ section.settings.story_text }}</p>

          {{
            section.settings.story_product
            | image_url: width: 1000
            | image_tag
          }}
        </div>

      </div>

    </div>

    <!-- CTA -->
    <div class="bb-footer-cta">
      <a href="{{ section.settings.final_link }}"
         class="bb-btn">
        EXPLORE APPAREL
      </a>
    </div>

  </div>
</section>

<style>

.bb-landing{
  background:#e9e0d1;
  color:#222;
  font-family:Arial,sans-serif;
  padding:60px 20px;
}

.bb-container{
  max-width:1200px;
  margin:auto;
}

.bb-launch-tag{
  display:inline-block;
  background:#d8742d;
  color:#fff;
  padding:8px 14px;
  font-weight:700;
  margin-bottom:25px;
}

.bb-hero-grid,
.bb-product-grid,
.bb-story-grid,
.bb-heritage{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:50px;
  align-items:center;
}

.bb-hero h1,
.bb-product h2,
.bb-story h2,
.bb-built h2{
  text-transform:uppercase;
  letter-spacing:1px;
}

.bb-built{
  margin:100px 0;
}

.bb-fit-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
  margin-top:30px;
}

.bb-fit-item{
  text-align:center;
}

.bb-fit-item img{
  width:100%;
}

.bb-product{
  margin:100px 0;
}

.bb-product img,
.bb-story img,
.bb-heritage img,
.bb-image img{
  width:100%;
  display:block;
}

.bb-product-content{
  display:flex;
  flex-direction:column;
  gap:20px;
}

.bb-btn{
  display:inline-block;
  background:#111;
  color:#fff;
  padding:14px 28px;
  text-decoration:none;
  font-weight:700;
  width:fit-content;
}

.bb-story{
  margin:100px 0;
}

.bb-story-images{
  display:flex;
  gap:20px;
}

.bb-footer-cta{
  text-align:center;
  margin-top:80px;
}

@media(max-width:768px){

  .bb-hero-grid,
  .bb-product-grid,
  .bb-story-grid,
  .bb-heritage{
    grid-template-columns:1fr;
  }

  .bb-fit-grid{
    grid-template-columns:1fr;
  }

  .bb-story-images{
    flex-direction:column;
  }
}

</style>

{% schema %}
{
  "name": "Blue Blood Landing",
  "settings": [
    {
      "type":"text",
      "id":"hero_title",
      "label":"Hero Title",
      "default":"BLUE BLOOD SELVEDGE"
    },
    {
      "type":"textarea",
      "id":"hero_description",
      "label":"Hero Description"
    },
    {
      "type":"image_picker",
      "id":"hero_image",
      "label":"Hero Image"
    },

    {
      "type":"text",
      "id":"product1_title",
      "label":"Product 1 Title",
      "default":"Blue Blood 2.0 True Straight"
    },
    {
      "type":"textarea",
      "id":"product1_text",
      "label":"Product 1 Description"
    },
    {
      "type":"image_picker",
      "id":"product1_image",
      "label":"Product 1 Image"
    },
    {
      "type":"image_picker",
      "id":"product1_fabric",
      "label":"Product 1 Fabric Image"
    },
    {
      "type":"url",
      "id":"product1_link",
      "label":"Product 1 Link"
    },

    {
      "type":"textarea",
      "id":"heritage_text",
      "label":"Heritage Text"
    },
    {
      "type":"image_picker",
      "id":"heritage_image",
      "label":"Heritage Image"
    },

    {
      "type":"text",
      "id":"product2_title",
      "label":"Product 2 Title"
    },
    {
      "type":"textarea",
      "id":"product2_text",
      "label":"Product 2 Text"
    },
    {
      "type":"image_picker",
      "id":"product2_image",
      "label":"Product 2 Image"
    },
    {
      "type":"url",
      "id":"product2_link",
      "label":"Product 2 Link"
    },

    {
      "type":"text",
      "id":"product3_title",
      "label":"Product 3 Title"
    },
    {
      "type":"textarea",
      "id":"product3_text",
      "label":"Product 3 Text"
    },
    {
      "type":"image_picker",
      "id":"product3_image",
      "label":"Product 3 Image"
    },
    {
      "type":"url",
      "id":"product3_link",
      "label":"Product 3 Link"
    },

    {
      "type":"image_picker",
      "id":"story_image_1",
      "label":"Story Image 1"
    },
    {
      "type":"image_picker",
      "id":"story_image_2",
      "label":"Story Image 2"
    },
    {
      "type":"image_picker",
      "id":"story_product",
      "label":"Story Product"
    },
    {
      "type":"textarea",
      "id":"story_text",
      "label":"Story Text"
    },

    {
      "type":"url",
      "id":"final_link",
      "label":"Final CTA Link"
    }
  ],

  "blocks":[
    {
      "type":"fit_image",
      "name":"Fit Image",
      "settings":[
        {
          "type":"image_picker",
          "id":"image",
          "label":"Image"
        },
        {
          "type":"text",
          "id":"label",
          "label":"Label"
        }
      ]
    }
  ],

  "presets":[
    {
      "name":"Blue Blood Landing"
    }
  ]
}
{% endschema %}